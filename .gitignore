# ==========================================
# 1. Dependency Directories
# ==========================================
node_modules/
jspm_packages/
web_modules/
.pnpm-store

# ==========================================
# 2. Production & Build Outputs (React/Vite)
# ==========================================
build/
dist/
out/
.next/
.output/

# ==========================================
# 3. Environment & Security Secrets (STRICT)
# ==========================================
# Exclude .env in root and across all 4 portal directories
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.*.local

# Prohibit SSL keys and certificate files
*.pem
*.key
*.cer
*.crt

# Keep example templates safe to commit
!**/.env.example

# ==========================================
# 4. Logs & Diagnostic Dumps
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# 5. IDE & Operating System Files
# ==========================================
# Editor caches
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# 6. Runtime & Testing Artifacts
# ==========================================
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage/
*.lcov
.nyc_output
.cache
.parcel-cache
.eslintcache
.stylelintcache
*.tsbuildinfo
*.tgz
.yarn-integrity
